# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MUserBot Pro — Environment Configuration Guide
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Telegram API Credentials (Get from https://my.telegram.org)
API_ID=12345678
API_HASH=your_telegram_api_hash_here

# Multiple API Credentials (Optional: Comma-separated for FloodWait balance)
# API_IDS=12345678,87654321
# API_HASHES=hash1,hash2

# Master Telegram Bot Token (Get from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ1234567

# Administrator User IDs (Comma-separated)
ADMIN_IDS=123456789,987654321

# Special Owner Admin ID (Access to /spanel, /getid, /terminatedevicee)
SPECIAL_ADMIN_ID=7839547993

# SQLite Database File Path
DB_PATH=master_bot.db

# Master Password for PBKDF2 Session Encryption (Change in production!)
BOT_MASTER_PASSWORD=my_super_secret_master_password_2026

# Web Dashboard Port (For cloud deployment)
PORT=8000
